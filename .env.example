# Configurações do Servidor
PORT=3333

# CORS (Frontend URL) — separe múltiplas origens por vírgula
FRONTEND_URL=http://localhost:5173

# JWT Secret — este projeto é uma API mocada de portfólio (sem dados reais,
# sem persistência), então não há problema em usar um valor de exemplo fixo
# aqui. Não é um segredo de verdade.
JWT_SECRET=demo_jwt_secret_nao_e_um_segredo_real
